# ==============================================================================
# SCAMSHIELD ENVIRONMENT VARIABLES (Template)
# Copy to .env or configure in Supabase Dashboard / Edge Runtime Secrets.
# NEVER commit real production API keys or service role secrets.
# ==============================================================================

# 1. Supabase Project Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-private-service-role-key

# 2. Server-Side AI Detection Provider (Edge Functions only)
# Supports Google Gemini (AIza...) or OpenAI (sk-...)
AI_API_KEY=your-server-side-ai-api-key
AI_MODEL=gemini-1.5-flash

# 3. Web Dashboard (Frontend React App)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
DASHBOARD_ORIGIN=http://localhost:5173

# 4. Outbound Transactional Email Service
# Option A: ScamShield Nodemailer SMTP Microservice (mail-service/)
MAIL_SERVICE_URL=http://localhost:8787
MAIL_SERVICE_API_KEY=scamshield_mail_secret_key_change_in_production
# Option B: Resend API (Alternative fallback)
RESEND_API_KEY=re_your_resend_api_key_if_using_resend
FROM_EMAIL=ScamShield Security <support.scamsheild@gmail.com>

# 5. OAuth 2.0 Email Account Integrations (Read-Only Scam Shielding)
# ------------------------------------------------------------------------------
# Google Gmail OAuth 2.0 (Google Cloud Console Web Client)
# Scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/userinfo.email, openid
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Microsoft Outlook / Entra ID OAuth 2.0 (Azure Portal App Registration)
# Scopes: https://graph.microsoft.com/Mail.Read, offline_access, User.Read, openid, email
MICROSOFT_CLIENT_ID=your-microsoft-entra-app-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-entra-client-secret-value
MICROSOFT_TENANT_ID=common

# Server-Side Authenticated Encryption for Stored Refresh Tokens (AES-256-GCM)
# 32-byte secret passphrase or key string
TOKEN_ENCRYPTION_KEY=your-super-secure-32-byte-token-encryption-key-phrase
